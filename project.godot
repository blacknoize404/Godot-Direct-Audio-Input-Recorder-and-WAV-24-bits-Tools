; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Direct Audio Input Plugin"
run/main_scene="uid://g7ru42ovfg71"
config/features=PackedStringArray("4.6", "GL Compatibility")
run/low_processor_mode=true
config/icon="res://icon.svg"

[audio]

driver/enable_input=true

[display]

window/size/viewport_width=500
window/size/viewport_height=650
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Direct Audio Input Plugin"

[editor_plugins]

enabled=PackedStringArray("res://addons/direct_audio_and_wav_24bits/plugin.cfg")

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
